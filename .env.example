PORT=5085
ACCESS_API_KEY=dev-local-key

# access | postgres | auto
DB_PROVIDER=access

# Access mode
ACCESS_DB_PATH=./database.accdb

# PostgreSQL mode
# Example: postgres://user:pass@host:5432/dbname
DATABASE_URL=
# Second Neon account (extra columns). API merges both by الهوية.
DATABASE_URL_EXTRA=
PG_SCHEMA=public
# If empty, request "table" value is used.
PG_TABLE=
# Optional separate table name in extra DB (default: same as PG_TABLE / request table)
PG_TABLE_EXTRA=
# Set to true for managed Postgres requiring SSL.
PG_SSL=false
PG_SSL_EXTRA=true

DEFAULT_TABLE=Sgaza
ALLOWED_TABLES=Sgaza,قائمة الموظفين
ALLOWED_ID_COLUMNS=الهوية,id,identity